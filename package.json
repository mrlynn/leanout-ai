{
  "name": "leanout-tmp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/audit-env.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "check:env": "node scripts/audit-env.mjs",
    "check:env:strict": "STRICT_ENV=1 node scripts/audit-env.mjs",
    "check:health": "node scripts/check-health.mjs",
    "test": "MONGODB_URI=mongodb://localhost/test node node_modules/vitest/dist/cli.js run",
    "test:watch": "MONGODB_URI=mongodb://localhost/test node node_modules/vitest/dist/cli.js",
    "test:coverage": "MONGODB_URI=mongodb://localhost/test node node_modules/vitest/dist/cli.js run --coverage",
    "test:e2e": "node node_modules/.bin/playwright test",
    "test:e2e:ui": "node node_modules/.bin/playwright test --ui",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@auth/mongodb-adapter": "^3.11.2",
    "@base-ui/react": "^1.5.0",
    "@capacitor/camera": "^7.0.1",
    "@capacitor/core": "^7.2.0",
    "@capacitor/push-notifications": "^7.0.1",
    "@capgo/capacitor-health": "^7.2.15",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^2.4.6",
    "@vercel/blob": "^0.27.3",
    "barcode-detector": "^3.2.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "mongoose": "^9.6.3",
    "next": "16.2.7",
    "next-auth": "^5.0.0-beta.31",
    "openai": "^6.42.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "resend": "^6.12.4",
    "shadcn": "^4.10.0",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "mongodb-memory-server": "^11.2.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
